{
  "name": "fullstack-learning-lab",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "pnpm --stream --parallel --filter @fullstack-lab/api --filter @fullstack-lab/web run dev",
    "build": "pnpm --filter @fullstack-lab/api --filter @fullstack-lab/web run build",
    "check": "pnpm --filter @fullstack-lab/api --filter @fullstack-lab/web run check",
    "test": "pnpm --filter @fullstack-lab/api --filter @fullstack-lab/web run test",
    "test:watch": "pnpm --parallel --filter @fullstack-lab/api --filter @fullstack-lab/web run test:watch",
    "test:integration": "node apps/api/scripts/run-integration-tests.mjs",
    "test:all": "pnpm test && pnpm test:integration",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter @fullstack-lab/api run db:migrate",
    "db:studio": "pnpm --filter @fullstack-lab/api run db:studio",
    "infra:up": "docker compose up -d postgres minio",
    "infra:down": "docker compose down",
    "stack:build": "docker compose build api web",
    "stack:up": "docker compose up --build -d",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f api web",
    "storage:migrate-local": "pnpm --filter @fullstack-lab/api run storage:migrate-local"
  }
}
