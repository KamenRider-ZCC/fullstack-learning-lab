# Docker Compose 自动读取根目录的 .env。以下值只适合本地学习。
POSTGRES_DB=fullstack_lab
POSTGRES_USER=fullstack
POSTGRES_PASSWORD=fullstack_dev_password
POSTGRES_HOST_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=fullstack-documents
MINIO_REGION=us-east-1
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

JWT_SECRET=local-docker-learning-secret-change-before-production
PREVIEW_URL_TTL_SECONDS=300
API_HOST_PORT=3000
WEB_HOST_PORT=8080

# 这是签名 URL 返回给浏览器访问的地址，不是容器之间访问 MinIO 的地址。
MINIO_PUBLIC_URL=http://127.0.0.1:9000
