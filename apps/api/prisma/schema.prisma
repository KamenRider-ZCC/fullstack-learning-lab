generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  passwordHash String
  role         String
  documents    Document[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Document {
  id           String   @id @default(cuid())
  originalName String
  storageKey   String   @unique
  mimeType     String
  size         Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([uploadedById])
}

model ReviewItem {
  id          String        @id
  title       String
  description String
  maxScore    Float
  aiScore     Float
  scores      ExpertScore[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ExpertScore {
  id           String     @id @default(cuid())
  reviewItemId String
  bidderId     String
  expertId     String
  score        Float
  feedback     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  reviewItem   ReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)

  @@unique([reviewItemId, bidderId, expertId])
  @@index([reviewItemId])
}
