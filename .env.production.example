APP_DOMAIN=review.example.com

API_IMAGE=ghcr.io/kamenrider-zcc/fullstack-learning-lab-api:sha-replace-me
WEB_IMAGE=ghcr.io/kamenrider-zcc/fullstack-learning-lab-web:sha-replace-me

POSTGRES_DB=fullstack_lab
POSTGRES_USER=fullstack
POSTGRES_PASSWORD=replace_with_a_long_database_password
DATABASE_URL=postgresql://fullstack:replace_with_url_encoded_database_password@postgres:5432/fullstack_lab?schema=public

MINIO_ROOT_USER=replace_with_a_minio_access_key
MINIO_ROOT_PASSWORD=replace_with_a_long_minio_secret_key
MINIO_BUCKET=fullstack-documents
MINIO_REGION=us-east-1

JWT_SECRET=replace_with_at_least_32_random_characters
PREVIEW_URL_TTL_SECONDS=300

TLS_CERT_PATH=/etc/letsencrypt/live/review.example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/review.example.com/privkey.pem
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
